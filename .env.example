# Plantilla de entorno. Bootstrap la copia a .env si .env no existe.
# Valores locales reales para docker compose; ninguno es un secreto de producción.

# Base de datos (docker compose: servicio postgres) — requerida desde el paso 2
# 127.0.0.1 y no localhost: en Windows localhost resuelve a ::1 y puede caer en otro proceso.
DATABASE_URL=postgres://corban:corban@127.0.0.1:5432/corban
# Base de pruebas (la recrea pnpm db:test:prepare) — requerida desde el paso 2
TEST_DATABASE_URL=postgres://corban:corban@127.0.0.1:5432/corban_test

# Autenticación (better-auth) — requerida desde el paso 5. Valor SOLO para desarrollo.
BETTER_AUTH_SECRET=dev-solo-local-no-usar-en-produccion-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
# 1 habilita POST /api/test/login fuera de producción (en producción siempre responde 404)
AUTH_TEST_LOGIN=1

# Primer administrador del staff (lo crea pnpm db:seed) — requerida desde el paso 3
ADMIN_EMAIL=admin@corbanfc.com

# Microsoft Entra ID para el staff. Vacíos en local: Entra no corre en local.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# Almacenamiento de documentos: fs (local/pruebas) | azure — desde el paso 12
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=documentos
AZURE_STORAGE_CONNECTION_STRING=

# Correo: file (local/pruebas) | smtp (Mailpit) | acs (Azure Communication Services) — desde el paso 5
MAIL_DRIVER=file
MAIL_FILE_DIR=.data/mail
MAIL_FROM="Corban FC <no-responder@corbanfc.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
ACS_CONNECTION_STRING=

LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
