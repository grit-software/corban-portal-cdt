{
  "name": "corban-portal-cdt",
  "version": "0.1.0",
  "private": true,
  "description": "Corban FC — Portal de CDT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx scripts/migrate.ts",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "db:seed:demo": "dotenv -e .env -- tsx scripts/seed.ts --demo",
    "db:test:prepare": "dotenv -e .env -- tsx scripts/db-test-prepare.ts",
    "db:studio": "dotenv -e .env -- drizzle-kit studio",
    "services:up": "docker compose up -d --wait postgres",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v"
  },
  "dependencies": {
    "@azure/communication-email": "1.1.0",
    "@azure/identity": "4.14.1",
    "@azure/storage-blob": "12.34.0",
    "@hookform/resolvers": "7.0.2",
    "@tanstack/react-query": "5.105.3",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-cli": "11.1.0",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
